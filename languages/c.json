{
  "$schema": "./schema.json",
  "name": "C",
  "id": "c",
  "ext": [".c", ".h"],
  "comments": [
    { "line": "///", "dialect": "doxygen" },
    { "line": "//!", "dialect": "doxygen" },
    { "line": "//", "dialect": "markdown" },
    { "kind": "delimited", "start": "/**", "end": "*/", "decorate": "*", "dialect": "doxygen" },
    { "kind": "delimited", "start": "/*", "end": "*/", "decorate": "*", "dialect": "markdown" }
  ]
}
