{
  "$schema": "./schema.json",
  "name": "C#",
  "id": "csharp",
  "ext": [
    ".cs"
  ],
  "comments": [
    {
      "line": "///",
      "dialect": "xmldoc"
    },
    {
      "line": "//",
      "dialect": "markdown"
    },
    {
      "kind": "delimited",
      "start": "/**",
      "end": "*/",
      "decorate": "*",
      "dialect": "xmldoc"
    },
    {
      "kind": "delimited",
      "start": "/*",
      "end": "*/",
      "decorate": "*",
      "dialect": "markdown"
    }
  ]
}
