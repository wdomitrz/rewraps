{
  "$schema": "./schema.json",
  "name": "Common Lisp",
  "id": "commonlisp",
  "ext": [
    ".lisp",
    ".lsp"
  ],
  "comments": [
    {
      "line": ";",
      "dialect": "markdown"
    },
    {
      "kind": "delimited",
      "start": "#|",
      "end": "|#",
      "nesting": true,
      "dialect": "markdown"
    }
  ]
}
