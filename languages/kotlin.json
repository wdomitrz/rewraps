{
  "$schema": "./schema.json",
  "name": "Kotlin",
  "id": "kotlin",
  "ext": [".kt", ".kts"],
  "comments": [
    { "line": "///", "dialect": "markdown" },
    { "line": "//", "dialect": "markdown" },
    { "kind": "delimited", "start": "/**", "end": "*/", "nesting": true, "decorate": "*", "dialect": "markdown" },
    { "kind": "delimited", "start": "/*", "end": "*/", "nesting": true, "dialect": "markdown" }
  ]
}
