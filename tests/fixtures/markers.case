# One case per language, so no language can ship without proof that its
# marker is wired up. The interesting behaviour lives in the hand-written
# files beside this one.

[case]
name = a comment wraps
language = ada
column = 30
-- input
-- alpha beta gamma delta epsilon zeta
-- output
-- alpha beta gamma delta
-- epsilon zeta
[case]
name = a comment wraps
language = bat
column = 30
-- input
rem  alpha beta gamma delta epsilon zeta
-- output
rem alpha beta gamma delta
rem epsilon zeta
